# Leantime API Configuration
LEANTIME_URL=https://your-leantime-instance.com
LEANTIME_API_KEY=your_api_key_here
LEANTIME_USER_EMAIL=your_user_email_here

# Named profile (optional). When set, the server reads the prefixed keys
# LEANTIME_<PROFILE>_URL / LEANTIME_<PROFILE>_API_KEY /
# LEANTIME_<PROFILE>_USER_EMAIL instead of the plain names above.
# Useful for running several server instances, one per user, from one .env file:
#LEANTIME_PROFILE=ALICE
#LEANTIME_ALICE_URL=https://your-leantime-instance.com
#LEANTIME_ALICE_API_KEY=your_api_key_here
#LEANTIME_ALICE_USER_EMAIL=your_user_email_here

# MCP transport (optional; default: stdio)
# stdio            — process-spawning clients (VS Code, Claude Desktop)
# streamable-http  — Streamable HTTP for HTTP clients (set with LEANTIME_MCP_* below)
#LEANTIME_MCP_TRANSPORT=streamable-http
#LEANTIME_MCP_HOST=127.0.0.1
#LEANTIME_MCP_PORT=8000
#LEANTIME_MCP_PATH=/mcp
# Comma-separated Host/Origin allow-list for DNS-rebinding protection
# (defaults to the bind host:port plus localhost:port).
#LEANTIME_MCP_ALLOWED_HOSTS=127.0.0.1:8000,localhost:8000